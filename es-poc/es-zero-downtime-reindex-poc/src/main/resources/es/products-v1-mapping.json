{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "1s"
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id":          { "type": "keyword" },
      "sku":         { "type": "keyword" },
      "name":        { "type": "text" },
      "description": { "type": "text" },
      "priceCents":  { "type": "long" },
      "createdAt":   { "type": "date" }
    }
  }
}
